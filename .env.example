# Optional. Leave empty to use the embedded PGlite database (auto-migrated and seeded).
# For a persistent deployment, point this at Postgres (e.g. a free Neon database).
DATABASE_URL=

# IANA timezone the clinic operates in. All slots are generated in this zone.
CLINIC_TIMEZONE=America/New_York

# Optional. Enables the AI intake helper on /providers; without it, keyword rules are used.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=
